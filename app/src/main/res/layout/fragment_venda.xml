<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/areaBusca"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/busca"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Pesquisar"
            android:inputType="text" />

        <Button
            android:id="@+id/buscar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buscar" />


    </LinearLayout>

    <ProgressBar
        android:id="@+id/progresso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <TextView
        android:id="@+id/mensagem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="Nenhuma mercadoria encontrada"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lista"
        android:layout_width="match_parent"
        android:layout_height="302dp"
        android:layout_weight="1" />

    <View
        android:id="@+id/divisorCarrinho"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="?android:attr/listDivider"
        android:visibility="gone" />

    <TextView
        android:id="@+id/carrinhoLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Expandir carrinho"
        android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listaCarrinho"
        android:paddingTop="7dp"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_weight="1"
        android:visibility="gone"/>

    <Button
        android:id="@+id/prosseguir"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Subtotal: R$ 00,00" />
</LinearLayout>